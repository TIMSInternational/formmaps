<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared cross-repo LIA-core golden fixtures (byte-identical to lib/lia-core/__fixtures__/golden.json). -->
    <EmbeddedResource Include="Assessments\Data\golden.json" />
    <!-- CareerFit parity fixture (FM-CF-004): 60 archetypal profiles x 14 families scored by the NORMATIVE
         docs/careerfit/sources/formmaps_engine_reference.py. Regenerate ONLY with
         tools/careerfit/export_parity_fixture.py (n 60, default seed 20260903, out = this path);
         if the C# and the fixture disagree, the C# is wrong. -->
    <EmbeddedResource Include="CareerFit\Data\parity-fixture.json" />
    <!-- CareerFit 360 parity fixture (FM-CF-007/008): synthetic per-source scores and synthetic variable
         aggregates scored by the same NORMATIVE reference engine, because the 40 items are not seeded
         (FM-CF-006, blocked on TIMS) and no real 360 response exists. Regenerate ONLY with
         tools/careerfit/export_v360_fixture.py (out = this path); if the C# and the fixture disagree,
         the C# is wrong. -->
    <EmbeddedResource Include="CareerFit\Data\v360-parity-fixture.json" />
    <!-- Informe line-break ground truth: pdfkit's own wrapping of every string in the informe label
         dictionary and interpretive library, across the four Poppins faces and the document's real
         column widths. Captured by running the LEGACY renderer (tafurfede/formmaps-platform,
         origin/main, api/node_modules/pdfkit) and intercepting PDFDocument._line. The .NET port's
         page counts only match the shipped document if LayoutMath.WrapLines agrees with pdfkit, and
         this is the evidence that it does; if the C# and the fixture disagree, the C# is wrong.
         Regenerate ONLY from pdfkit; never hand-edit. NOTE: not named *golden.json — LiaCoreGoldenTests
         resolves its own fixture by that suffix with Single(), so a second one breaks it. -->
    <EmbeddedResource Include="Informe\Data\pdfkit-linebreaks.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Task 7 (Domain 7b realtime): FormMaps.Api reference for MessagesHub/SignalRMessagesNotifier/RealtimeTicketFactory unit tests. -->
    <ProjectReference Include="..\..\src\FormMaps.Api\FormMaps.Api.csproj" />
    <ProjectReference Include="..\..\src\FormMaps.Application\FormMaps.Application.csproj" />
    <ProjectReference Include="..\..\src\FormMaps.Domain\FormMaps.Domain.csproj" />
    <ProjectReference Include="..\..\src\FormMaps.Infrastructure\FormMaps.Infrastructure.csproj" />
  </ItemGroup>

</Project>