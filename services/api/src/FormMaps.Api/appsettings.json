{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LegacyJwt": {
    "Issuer": "formmaps-api",
    "Audience": "formmaps-frontend"
  },
  "Database": {
    "MaxPoolSize": 10,
    "TimeoutSeconds": 20
  },
  "ApiSecurity": {
    "AllowedOrigins": [],
    "RequestTimeoutMilliseconds": 60000,
    "JsonBodyLimitBytes": 10485760,
    "RateLimits": {
      "General": {
        "PermitLimit": 3000,
        "WindowSeconds": 900
      },
      "Auth": {
        "PermitLimit": 10,
        "WindowSeconds": 900
      },
      "Sensitive": {
        "PermitLimit": 10,
        "WindowSeconds": 3600
      },
      "Ai": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      }
    }
  },
  "AllowedHosts": "*"
}
