<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FormMaps.Application\FormMaps.Application.csproj" />
    <ProjectReference Include="..\FormMaps.Domain\FormMaps.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.4" />
    <PackageReference Include="AWSSDK.SimpleEmailV2" Version="4.0.101" />
    <!-- FM-DOTNET-087: AES-256-GCM field cipher (iSAMS credential encryption) needs a 16-byte-IV GCM to match
         Node's lib/fieldEncrypt.ts; .NET's native AesGcm rejects non-12-byte nonces, so BouncyCastle's GCM (which
         does the standard GHASH-based J0 derivation for a non-96-bit IV, identical to OpenSSL) is used. Version
         pinned to the one already present transitively in the test graph. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <!-- formmaps#99: BackgroundService, for BillingReconciliationWorker. That worker used to live in
         FormMaps.Workers, which services/api/Dockerfile never publishes (it publishes ONLY
         FormMaps.Api), so Domain 9a's hourly shadow-vs-live diff had never run in any deployed
         environment. Hosting it from FormMaps.Api needs BackgroundService available here, since
         FormMaps.Api references Application + Infrastructure only (see FormMaps.Api.csproj). Pinned
         to the same 10.0.10 line as the other Microsoft.Extensions.* references above. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
