<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FormMaps.Domain\FormMaps.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Verbatim TIMS personality profile bank (extracted from legacy personality-profiles.data.ts). -->
    <EmbeddedResource Include="Assessments\Data\personality-profiles.json" />
    <!-- Verbatim TIMS personality item bank (extracted from legacy personality-items.data.ts PERSONALITY_ITEMS; laboral 40 + estudiantil 80). -->
    <EmbeddedResource Include="Assessments\Data\personality-items.json" />
    <!-- LIA-core percentile norm tables (extracted from legacy percentile-mapper.ts PERCENTILE_TABLES; Infinity->1e9 sentinel). -->
    <EmbeddedResource Include="Assessments\Data\lia-percentile-tables.json" />
    <!-- LIA-core question bank raw items (extracted from the shared golden.json questionBank[305]; computed answers omitted, verbal static answers carried). -->
    <EmbeddedResource Include="Assessments\Data\lia-question-bank.json" />
    <!-- LIA-core EN verbal-reasoning question TEXT bank (extracted from legacy verbal-en.ts VERBAL_EN; certified human-reviewed content). -->
    <EmbeddedResource Include="Assessments\Data\lia-verbal-en.json" />
    <!-- Single source of truth for GET /api/v1/migration/roadmap (formmaps#12/#13): domain-grained
         code-completion + live-in-prod status, hand-maintained per the update convention documented
         inside the file itself and in docs/migration/domain-status-manifest.md. -->
    <EmbeddedResource Include="Migration\Data\domain-status.manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Stripe.net" Version="52.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
