NEXT_PUBLIC_API_BASE_URL=YOUR_BACKEND_API_URL
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=YOUR_STRIPE_PUBLIC_KEY
NEXT_PUBLIC_APP_URL=YOUR_FRONTEND_URL

# Messaging realtime (Domain 7b). BOTH must be set for the SignalR push path to do anything: with the
# flag on but the hub URL empty, useMessagesRealtime still no-ops silently. Default is OFF/dark — the
# 15s poll is the unconditional delivery path either way. Both are NEXT_PUBLIC_*, so they are inlined
# at BUILD time: flipping either requires a redeploy, not just an env change. Set the flag with
# `printf` rather than `echo` (a trailing newline has silently disabled a flag here before).
NEXT_PUBLIC_FORMMAPS_ROUTE_MESSAGES_REALTIME_TO_DOTNET=0
NEXT_PUBLIC_FORMMAPS_DOTNET_HUB_BASE_URL=YOUR_DOTNET_API_URL
