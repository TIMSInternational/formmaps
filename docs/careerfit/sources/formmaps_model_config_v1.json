{
  "metadata": {
    "model_name": "FORMMAPS CareerFit Rules Engine",
    "model_version": "1.0.0-expert-prior",
    "career_matrix_version": "1.0",
    "status": "implementation_specification",
    "source_workbook": "FORMMAPS_Matriz_Maestra_Logica_Implementacion_V1.xlsx",
    "notes": [
      "Expert Prior V1: no interpretar CareerFitAbsolute como probabilidad actuarial de éxito.",
      "Gates no descartan carreras; modifican estado y explicación.",
      "Personality no genera gates.",
      "PCA y Personality son multirruta."
    ]
  },
  "weights": {
    "career_fit": {
      "MIL": 0.25,
      "PCA": 0.3,
      "PERSONALITY": 0.15,
      "VOCATIONAL_360": 0.3
    },
    "pca_internal": {
      "DISC": 0.5,
      "COMPETENCIES": 0.5,
      "status": "PROVISIONAL"
    },
    "v360_sources": {
      "SELF": 0.35,
      "PARENT": 0.25,
      "TEACHER": 0.25,
      "PEER": 0.15
    },
    "relevance": {
      "CENTRAL": 3,
      "IMPORTANT": 2,
      "NOT_USED": 0
    },
    "mil_role": {
      "CRITICAL": 3,
      "IMPORTANT": 2,
      "COMPLEMENTARY": 1,
      "NOT_USED": 0
    },
    "competency_role": {
      "CRITICAL": 3,
      "IMPORTANT": 2,
      "COMPLEMENTARY": 0,
      "DIFFERENTIATOR": "report_only"
    }
  },
  "thresholds": {
    "mil_bands": [
      {
        "name": "INSUFFICIENT",
        "min": 1,
        "max": 17
      },
      {
        "name": "LOW",
        "min": 18,
        "max": 37
      },
      {
        "name": "ADEQUATE",
        "min": 38,
        "max": 56
      },
      {
        "name": "EXCEEDS",
        "min": 57,
        "max": 81
      },
      {
        "name": "EXCEPTIONAL",
        "min": 82,
        "max": 99
      }
    ],
    "convergence": {
      "strong_min": 70,
      "partial_min": 55
    },
    "v360_consensus": {
      "high_min": 70,
      "medium_min": 40
    },
    "v360_confidence": {
      "formula": {
        "consensus_weight": 0.7,
        "coverage_weight": 0.3
      },
      "high_min": 75,
      "medium_min": 55,
      "status": "PROVISIONAL"
    }
  },
  "pca": {
    "factor_scale": {
      "min": 0,
      "max": 100,
      "midpoint": 50
    },
    "states": {
      "ACTIVE": ">50",
      "PASSIVE": "<50",
      "NEUTRAL": "=50"
    },
    "match_formulas": {
      "ACTIVE": "match = score",
      "PASSIVE": "match = 100 - score",
      "NEUTRAL": "match = max(0, 100 - 2*abs(score-50))",
      "OPEN": "weight = 0; exclude from denominator"
    },
    "family_fit": "MAX(route_fits)"
  },
  "competencies": {
    "scale": {
      "min": 0,
      "max": 4
    },
    "levels": {
      "0": "Absent",
      "1": "Utilization",
      "2": "Contribution",
      "3": "Skill",
      "4": "Mastery"
    },
    "attainment": {
      "CRITICAL": "min(100, level/2*100)",
      "IMPORTANT": "min(100, level/1*100)"
    },
    "gate": {
      "SATISFIED": "all critical levels >=2",
      "CONDITIONED": "any critical level=1 and none=0",
      "CRITICAL": "any critical level=0"
    }
  },
  "mil": {
    "subtests": [
      "DC",
      "RZ",
      "VN",
      "MT",
      "OR"
    ],
    "family_fit": "sum(percentile_k * role_weight_k) / sum(role_weight_k)",
    "relative_strength": "percentile_k / max(DC,RZ,VN,MT,OR) * 100",
    "gate": {
      "SATISFIED": "all critical percentiles >=38",
      "CONDITIONED": "any critical percentile 18..37 and none <=17",
      "CRITICAL": "any critical percentile <=17"
    },
    "dc_note": "Transversal: aprendizaje aplicado, instrucción/velocidad general, reconocimiento de patrones y requerimiento de acompañamiento."
  },
